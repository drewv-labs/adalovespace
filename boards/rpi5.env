# ==============================================================================
# DREW-V Labs // AdaLovespace Board Adapter: Raspberry Pi 5 (`rpi5`)
# SoC: Broadcom BCM2712 (4x Cortex-A76 @ 2.4GHz) + RP1 Southbridge (`arm64`)
# ==============================================================================
BOARD_TAG="rpi5"
BOARD_SOC="broadcom-bcm2712"
BOARD_ARCH="arm64"
BOARD_CPU_CORES="4"
BOARD_RVDK_NATIVE="false"
CGROUP_BOOT_MODE="rpi-cmdline"
CGROUP_CMDLINE_FILE="/boot/firmware/cmdline.txt"

# RP1-Aware Cgroup v2 Core Partitioning (No isolcpus=)
# Core 0   : RP1 IRQ sink (xhci-hcd:usb1, xhci-hcd:usb3, eth0), SSH, Pigeoneer
# Core 1-2 : INDI Web Manager + indiserver + ZWO/AM5/EAF/EFW/Excalibur drivers
# Core 3   : Dedicated Xvfb + Headless PHD2 centroid loop
SLICE_SYSTEM_CPUS="0"
SLICE_USER_CPUS="0"
SLICE_OBSERVABILITY_CPUS="0"
SLICE_INDI_CPUS="1-2"
SLICE_GUIDING_CPUS="3"
SLICE_INFERENCE_CPUS=""
