# ==============================================================================
# DREW-V Labs // AdaLovespace Board Adapter: Milk-V Jupiter 2 (`jptr2`)
# SoC: SpacemiT K3 (8x X100 @ 2.4GHz + 60 TOPS, RVA23 + RVV 1.0, `riscv64`)
# ==============================================================================
BOARD_TAG="jptr2"
BOARD_SOC="spacemit-k3"
BOARD_ARCH="riscv64"
BOARD_CPU_CORES="8"
BOARD_RVDK_NATIVE="true"
CGROUP_BOOT_MODE="none"
CGROUP_CMDLINE_FILE=""

SLICE_SYSTEM_CPUS="0-1"
SLICE_USER_CPUS="0-1"
SLICE_OBSERVABILITY_CPUS="0-1"
SLICE_INDI_CPUS="2-4"
SLICE_GUIDING_CPUS="5"
SLICE_INFERENCE_CPUS="6-7"
