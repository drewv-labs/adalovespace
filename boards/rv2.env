# ==============================================================================
# DREW-V Labs // AdaLovespace Board Adapter: Orange Pi RV2 (`rv2`)
# SoC: SpacemiT Ky X1 / K1 Derivative (8x X60 @ 1.6GHz, RVA22 + RVV 1.0, `riscv64`)
# ==============================================================================
BOARD_TAG="rv2"
BOARD_SOC="spacemit-k1"
BOARD_ARCH="riscv64"
BOARD_CPU_CORES="8"
BOARD_RVDK_NATIVE="true"
CGROUP_BOOT_MODE="uboot-env"
CGROUP_CMDLINE_FILE="/boot/orangepiEnv.txt"

# Dual-Cluster 8-Hart X60 Cgroup v2 Core Partitioning (AdaCtrl-RV2 & ALOne-V Air)
# Hart 0-1 : PLIC/IRQ housekeeping, SSH, CarrierPigeons Pigeoneer (Cluster 0)
# Hart 2-4 : INDI Web Manager + indiserver + hardware drivers
# Hart 5   : Dedicated Xvfb + Headless PHD2 centroid loop
# Hart 6-7 : Reserved Edge NPU Inference (ALOne-V Air / Hailo-10H)
SLICE_SYSTEM_CPUS="0-1"
SLICE_USER_CPUS="0-1"
SLICE_OBSERVABILITY_CPUS="0-1"
SLICE_INDI_CPUS="2-4"
SLICE_GUIDING_CPUS="5"
SLICE_INFERENCE_CPUS="6-7"
