# ==============================================================================
# DREW-V Labs // AdaLovespace Node Role: `alonev-air`
# All-in-One RISC-V Scope Compute + Edge NPU Appliance (Orange Pi RV2 + Hailo-10H)
# ==============================================================================
NODE_ROLE="alonev-air"
NODE_GROUP="adascope"
RVDK_TUNE_PROFILE="ai"
PIGEON_ROLE="pigeoneer"

ENABLE_CGROUP_PARTITIONING="true"
ENABLE_INDI="true"
ENABLE_ZWO_ASI="false"
ENABLE_PHD2="true"
ENABLE_PIGEONEER="true"
DECOMMISSION_MARYGUIDER="true"

INDI_PORT="7624"
INDIWEB_PORT="8624"
INDI_RIG_PROFILE="Ada Lovespace Rig"
PHD2_PORT="4400"
PHD2_DISPLAY=":99"
PHD2_SCREEN_GEOM="1280x800x24"
PHD2_INDI_HOST="127.0.0.1"
