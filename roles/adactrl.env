# ==============================================================================
# DREW-V Labs // AdaLovespace Node Role: `adactrl`
# On-Scope Consolidated INDI Server + Headless PHD2 Guiding Engine + Pigeoneer
# Active: AdaCtrl-RPI5 (`rpi5`) -> Migration Target: AdaCtrl-RV2 (`rv2`)
# ==============================================================================
NODE_ROLE="adactrl"
NODE_GROUP="adascope"
RVDK_TUNE_PROFILE="ai"
PIGEON_ROLE="pigeoneer"

ENABLE_CGROUP_PARTITIONING="true"
ENABLE_INDI="true"
ENABLE_ZWO_ASI="true"
ENABLE_PHD2="true"
ENABLE_PIGEONEER="true"
DECOMMISSION_MARYGUIDER="true"

INDI_PORT="7624"
INDIWEB_PORT="8624"
INDI_RIG_PROFILE="Ada Lovespace Rig"
PHD2_PORT="4400"
PHD2_DISPLAY=":99"
PHD2_SCREEN_GEOM="1280x800x24"
PHD2_INDI_HOST="127.0.0.1"
PHD2_INDI_CAMERA="ZWO CCD ASI220MM Mini"
PHD2_INDI_MOUNT="ZWO AM5 USB"
PHD2_PIXEL_SIZE_UM="4.0"
PHD2_FOCAL_LENGTH_MM="300"
