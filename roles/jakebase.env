# ==============================================================================
# DREW-V Labs // AdaLovespace Node Role: `jakebase`
# AdaRak Central Data Broker (PostgreSQL 18.6 io_uring + Mosquitto + NFS-Ganesha + PigeonCoop)
# ==============================================================================
NODE_ROLE="jakebase"
NODE_GROUP="adarak"
RVDK_TUNE_PROFILE="data"
PIGEON_ROLE="pigeoncoop+pigeoneer"

ENABLE_POSTGRES="true"
ENABLE_MQTT_BROKER="true"
MQTT_PORT="1883"
ENABLE_NFS_SERVER="true"
NFS_BACKEND="ganesha"
VG_NAME="vg_ada"
LV_NAME="lv_pgdata"
NFS_LV_NAME="lv_nfsvault"
MOUNT_POINT="/mnt/nvme_data"
NFS_MOUNT_POINT="/mnt/adalovespace"
