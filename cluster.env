# ==============================================================================
# AdaLovespace Cluster Environment Matrix Configuration
# Syntax rules maintained strictly for dual POSIX Bash & Python tomllib/dotenv
# ==============================================================================

# // Style B]
ADA_BLU1="\e[38;5;39m"
ADA_BLU2="\e[38;5;27m"
ADA_PLUM="\e[38;5;53m"
ADA_GRAY="\e[38;5;240m"

# // Globals
ADA_SUBNET="10.42.0"
ADA_USER="ada"

# // Node Hardware Infrastructure Mapping
RADIAWRT_IP="${NET_DOMAIN_ROOT}.1"
ADABRAIN_IP="${NET_DOMAIN_ROOT}.10"
MARYGUID_IP="${NET_DOMAIN_ROOT}.20"
MARGARET_IP="${NET_DOMAIN_ROOT}.77"
CAROLINE_IP="${NET_DOMAIN_ROOT}.88"
JAKEBASE_IP="${NET_DOMAIN_ROOT}.99"

# // Central Telemetry Broker (Mosquitto)
MQTT_BROKER="${JAKEBASE_IP}"
MQTT_BROKER_PORT=1883
MQTT_ROOT_TOPIC="ada"
MQTT_SUB_TOPICS="alerts events telemetry"
# +-----------------+---------------------------------------------------+
# | ada/alerts      | Ntfy alerting
# | ada/events      | Events like eaf_start, eaf_stop, etc, with meta data
# | ada/telemetry   | Telesender node resource monitor
# +-----------------+---------------------------------------------------+

# // Centralized Cluster Network Storage (NFS Paths)
NFS_HOST="${JAKEBASE_IP}"
NFS_ROOT="/mnt/adaspace"
NFS_SHARE="${NFS_ROOT}/share"
NFS_CODE="${NFS_ROOT}/code"
NFS_WHEELHOUSE="${NFS_ROOT}/wheelhouse"

# // Node UI Control (NoMachine Topology)
NM_NODE="${MARGARET_IP}"
NM_V_MAJOR=9
NM_V_MINOR=7
NM_V_PATCH=3
NM_V_BUILD=1

# // Relational Telemetry Target Database (PostgreSQL)
PSQL_HOST="${JAKEBASE_IP}"
PSQL_PORT=5432
PSQL_DB_NAME="adaspace"
PSQL_TBL_NAME="staging"

PSQL_MQTT_DEST_FLD="payload"
PSQL_MQTT_TIMESTAMP_FLD="event_timestamp"

PSQL_CLUSTER_USER="cluster_agent"
PSQL_CLUSTER_PASSWORD="fustercluck"

PSQL_COURIER_USER="coffee_courier"
PSQL_COURIER_PASSWORD="starsucks"

# // Node Monitoring Agent Profiles (Telegraf Context)
TG_HOST="${JAKEBASE_IP}"
TG_INTERVAL="1s"
TG_FLUSH_INTERVAL="1s"
TG_OMIT_HOSTNAME="false"
TG_METRIC_BATCH_SIZE=500
TG_METRIC_BUFFER_LIMIT=10000
