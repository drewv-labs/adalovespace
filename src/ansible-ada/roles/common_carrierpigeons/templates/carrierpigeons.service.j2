[Unit]
Description=CarrierPigeons Edge Telemetry Suite
After=network.target

[Service]
Type=simple
User=carrierpigeons
Group=carrierpigeons
# Adjust the command flag if your Go binary expects a different config flag
ExecStart={{ carrierpigeons_install_path }}/bin/carrierpigeons
Restart=on-failure
RestartSec=5s

# Inject clusterwide variables as environment variables for the Go binary
Environment="MQTT_BROKER_URL=tcp://{{ mqtt_broker_ip }}:1883"
Environment="PG_CONNECTION_STRING=postgres://telemetry_user:password@{{ mqtt_broker_ip }}:5432/telemetry_db"

# Optional: Cap memory footprint so the telemetry daemon doesn't starve KStars or Hailo
MemoryMax=250M

[Install]
WantedBy=multi-user.target
