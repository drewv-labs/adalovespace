[Unit]
Description=JakeBase FastMCP Gateway
After=network.target postgresql.service mosquitto.service

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory=/opt/mcp-jakebase

# Inject clusterwide variables from inventory/group_vars/all.yml
Environment="PG_DSN=postgres://telemetry_user:password@{{ mqtt_broker_ip }}:5432/telemetry_db"
Environment="MQTT_BROKER={{ mqtt_broker_ip }}"

# Run directly from the uv-managed virtual environment
ExecStart=/opt/mcp-jakebase/.venv/bin/python server.py

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
