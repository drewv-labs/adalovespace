<INDIDriver>
<newSwitchVector device='Rotator Mini V1-2' name='DEBUG'>
  <oneSwitch name='ENABLE'>
      Off
  </oneSwitch>
  <oneSwitch name='DISABLE'>
      On
  </oneSwitch>
</newSwitchVector>
<newNumberVector device='Rotator Mini V1-2' name='POLLING_PERIOD'>
  <oneNumber name='PERIOD_MS'>
      1000
  </oneNumber>
</newNumberVector>
<newSwitchVector device='Rotator Mini V1-2' name='CONNECTION_MODE'>
  <oneSwitch name='CONNECTION_SERIAL'>
      On
  </oneSwitch>
  <oneSwitch name='CONNECTION_TCP'>
      Off
  </oneSwitch>
</newSwitchVector>
<newTextVector device='Rotator Mini V1-2' name='DEVICE_PORT'>
  <oneText name='PORT'>
      /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
  </oneText>
</newTextVector>
<newSwitchVector device='Rotator Mini V1-2' name='DEVICE_BAUD_RATE'>
  <oneSwitch name='9600'>
      Off
  </oneSwitch>
  <oneSwitch name='19200'>
      On
  </oneSwitch>
  <oneSwitch name='38400'>
      Off
  </oneSwitch>
  <oneSwitch name='57600'>
      Off
  </oneSwitch>
  <oneSwitch name='115200'>
      Off
  </oneSwitch>
  <oneSwitch name='230400'>
      Off
  </oneSwitch>
</newSwitchVector>
<newSwitchVector device='Rotator Mini V1-2' name='ROTATOR_REVERSE'>
  <oneSwitch name='INDI_ENABLED'>
      Off
  </oneSwitch>
  <oneSwitch name='INDI_DISABLED'>
      On
  </oneSwitch>
</newSwitchVector>
<newNumberVector device='Rotator Mini V1-2' name='ROTATOR_LIMITS'>
  <oneNumber name='ROTATOR_LIMITS_VALUE'>
      90
  </oneNumber>
</newNumberVector>
</INDIDriver>
