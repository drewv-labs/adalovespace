# ==============================================================================
# DREW-V Labs // AdaLovespace Node Spec (`~/.adalovespace/node.env`)
# Reference Example: AdaCtrl-RPI5 (Raspberry Pi 5 4GB — INDI + Headless PHD2)
# Generated via: `sudo ada init --role adactrl --board rpi5`
# ==============================================================================
NODE_ROLE="adactrl"
BOARD_TAG="rpi5"
TARGET_HOSTNAME="adactrl-rpi5"
ADMIN_USER="drew"
ADA_SUBNET="10.42.0.0/24"

# -- Workload Toggles --
ENABLE_CGROUP_PARTITIONING="true"
DECOMMISSION_MARYGUIDER="true"
ENABLE_INDI="true"
ENABLE_ZWO_ASI="true"
ENABLE_PHD2="true"
ENABLE_PIGEONEER="true"

# -- RP1-Aware Cgroup v2 Core Partitioning (BCM2712 4x Cortex-A76) --
SLICE_SYSTEM_CPUS="0"
SLICE_USER_CPUS="0"
SLICE_OBSERVABILITY_CPUS="0"
SLICE_INDI_CPUS="1-2"
SLICE_GUIDING_CPUS="3"
SLICE_INFERENCE_CPUS=""

# -- INDI Server & Web Manager (`AdaScope-8F4`) --
INDI_PORT="7624"
INDIWEB_PORT="8624"
INDI_RIG_PROFILE="Ada Lovespace Rig"
SITE_LAT="32.78"
SITE_LON="263.20"
SITE_ELEV="130.0"

# -- Headless Xvfb + PHD2 Guiding (`guiding.slice`) --
PHD2_PORT="4400"
PHD2_DISPLAY=":99"
PHD2_SCREEN_GEOM="1280x800x24"
PHD2_INDI_HOST="127.0.0.1"
PHD2_INDI_CAMERA="ZWO CCD ASI220MM Mini"
PHD2_INDI_MOUNT="ZWO AM5 USB"
PHD2_PIXEL_SIZE_UM="4.0"
PHD2_FOCAL_LENGTH_MM="300"

# -- CarrierPigeons Telemetry (`observability.slice`) --
PIGEONEER_NODE_ID="adactrl-rpi5"
PIGEONEER_BROKER_URL="tcp://jakebase:1883"
PIGEONEER_TAGS="arm64,rpi5,adascope,indi,phd2"
PIGEONEER_MQTT_USERNAME=""
PIGEONEER_MQTT_PASSWORD=""
