# ==============================================================================
# DREW-V Labs // AdaLovespace Node Spec (`~/.adalovespace/node.env`)
# Reference Example: AdaCtrl-RV2 (Orange Pi RV2 8-Hart Ky X1 `riscv64` Stub)
# Generated via: `sudo ada init --role adactrl --board rv2`
# ==============================================================================
NODE_ROLE="adactrl"
BOARD_TAG="rv2"
TARGET_HOSTNAME="adactrl-rv2"
ADMIN_USER="drew"
ADA_SUBNET="10.42.0.0/24"
RVDK_TUNE_PROFILE="ai"

# -- Workload Toggles --
ENABLE_CGROUP_PARTITIONING="true"
DECOMMISSION_MARYGUIDER="true"
ENABLE_INDI="true"
ENABLE_ZWO_ASI="false"
ENABLE_PHD2="true"
ENABLE_PIGEONEER="true"

# -- 8-Hart SpacemiT Ky X1 Cgroup v2 Core Partitioning --
SLICE_SYSTEM_CPUS="0-1"
SLICE_USER_CPUS="0-1"
SLICE_OBSERVABILITY_CPUS="0-1"
SLICE_INDI_CPUS="2-4"
SLICE_GUIDING_CPUS="5"
SLICE_INFERENCE_CPUS="6-7"

# -- INDI Server & Web Manager (`AdaScope-8F4`) --
INDI_PORT="7624"
INDIWEB_PORT="8624"
INDI_RIG_PROFILE="Ada Lovespace Rig"
SITE_LAT="32.78"
SITE_LON="263.20"
SITE_ELEV="130.0"

# -- Headless Xvfb + PHD2 Guiding (`guiding.slice`) --
PHD2_PORT="4400"
PHD2_DISPLAY=":99"
PHD2_SCREEN_GEOM="1280x800x24"
PHD2_INDI_HOST="127.0.0.1"
PHD2_INDI_CAMERA="ZWO CCD ASI220MM Mini"
PHD2_INDI_MOUNT="ZWO AM5 USB"
PHD2_PIXEL_SIZE_UM="4.0"
PHD2_FOCAL_LENGTH_MM="300"

# -- CarrierPigeons Telemetry (`observability.slice`) --
PIGEONEER_NODE_ID="adactrl-rv2"
PIGEONEER_BROKER_URL="tcp://jakebase:1883"
PIGEONEER_TAGS="riscv64,rv2,adascope,indi,phd2"
PIGEONEER_MQTT_USERNAME=""
PIGEONEER_MQTT_PASSWORD=""
