# // Nodes
ADABRAIN_IP=""
CAROLINE_IP=""
JAKEBASE_IP=""
MARGARET_IP=""
MARYGUID_IP=""
RADIAWRT_IP=""

# // JakeBaseMQTT: Mosquitto
MQTT_ROOT_TOPIC="adaspace"
MQTT_SUB_TOPICS="issues events metadata telemetry"

# // JakeBaseMQTT: Mosquitto Broker
MQTT_BROKER_IP="${JAKEBASE_IP}"
MQTT_BROKER_PORT="1883"

# // JakeBaseNFS
NFS_ROOT="/mnt/adaspace"
NFS_SHARE="${NFS_ROOT}/share"
NFS_CODE="${NFS_ROOT}/code"
NFS_WHEELHOUSE="${NFS_ROOT}/wheelhouse"

# // Margaret's NoMachine
NM_V_MAJOR=9
NM_V_MINOR=7
NM_V_PATCH=3
NM_V_BUILD=1
NM_V_MAJMIN="${NM_V_MAJOR}.${NM_V_MINOR}"
NM_V_FULL="${NM_V_MAJOR}.${NM_V_MINOR}.${NM_V_PATCH}_${NM_V_BUILD}"

# // JakeBaseDB: PostgreSQL
PSQL_DB_NAME="adaspace"
PSQL_TBL_NAME="staging"
PSQL_MQTT_DEST_FLD="payload"
PSQL_MQTT_TIMESTAMP_FLD="event_timestamp"
PSQL_FLDAGNT_USER="field_agent"
PSQL_FLDAGNT_PASSWORD="fieldagent"
PQSL_COURIER_USER="coffee_courier"
PSQL_COURIER_PASSWORD="coffeecourier"

# // JakeBase Telegraf Ingestion Engine
TG_INTERVAL="1s"
TG_FLUSH_INTERVAL="1s"
TG_OMIT_HOSTNAME="false"
TG_METRIC_BATCH_SIZE=500
TG_METRIC_BUFFER_LIMIT=10000
