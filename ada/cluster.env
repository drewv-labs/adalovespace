# ==============================================================================
# AdaLovespace Cluster Environment Matrix Configuration
# Syntax rules maintained strictly for dual POSIX Bash & Python tomllib/dotenv
# ==============================================================================

# // Pegging to 0.0.1 for rapid prototyping
# // once stable bootstrappers exist for each node
# // then will start incorporating official versioning
# // starting with 0.1.0
ADA_VERSION="0.0.1"

# -- Users -- #
ADAUSR_SRV="adanaut"
ADAUSR_ADM="drew"

# -- Filepath Anchors -- #
ADA_LOCAL_LOGS="/var/log/ada"

# // This is where you cloned the repo to
# // recommendation is to simple clone into
# // the user homedir that you use to log in with.
# // e.g. cd ~ && git clone https://github.com/dvandagriff/adalovespace
ADA_GIT_ROOT="/home/${ADAUSR_ADM}/adalovespace"

# // This is the prod runtime env
ADA_CODESPACE="/opt/adalovespace"

# // splitting this up so that its easy to refactor later on...
ADA_CLUST_S="ada/cluster"
ADA_CLUSTER="${ADA_CODESPACE}/${ADA_CLUST_S}"


# // Node IP Mapping // # ---------------------------------
ADA_SUBNET="10.42.0"
RADIAWRT_IP="${ADA_SUBNET}.1"
ADABRAIN_IP="${ADA_SUBNET}.10"
MARYGUID_IP="${ADA_SUBNET}.20"
MARGARET_IP="${ADA_SUBNET}.77"
CAROLINE_IP="${ADA_SUBNET}.88"
JAKEBASE_IP="${ADA_SUBNET}.99"


# // Node Role Mapping // # ----------------------------------------------------

ADAROL_NETWORKER="${RADIAWRT_IP}"
ADAROL_INDIWEBER="${ADABRAIN_IP}"
ADAROL_GUIDINGER="${MARYGUID_IP}"
ADAROL_MAESTROER="${MARGARET_IP}"
ADAROL_INFERENCR="${CAROLINE_IP}"
ADAROL_DATABROKR="${JAKEBASE_IP}"


# // Node Hardware Mapping // # ----------------------------------------------

RADIAWRT_HW="openwrt"
ADABRAIN_HW="rpi"
MARYGUID_HW="rpi"
MARGARET_HW="ubuntu"
CAROLINE_HW="debian"
JAKEBASE_HW="rpi"


# // Mosquitto (MQTT Broker) // # ----------------------------------------------

MQTT_BROKER="${ADAROL_DATABROKR}"
MQTT_PORT="1883"
MQTT_ROOT_TOPIC="ada"
MQTT_SUB_TOPICS="alerts events telemetry"

# +-----------------+----------------------------------------------------------+
# | Topic           | Description                                              |
# +-----------------+----------------------------------------------------------+
# | ada/alerts      | Ntfy alerting                                            |
# | ada/events      | Events like eaf_start, dustcap_off, etc, with meta data  |
# | ada/telemetry   | Telesender node resource monitor                         |
# +-----------------+----------------------------------------------------------+


# // Network File System (NFS) // # --------------------------------------------

NFS_HOST="${ADAROL_DATABROKR}"
NFS_ROOT="/mnt/ada"

NFS_CODE="${NFS_ROOT}/code"
NFS_LOGS="${NFS_ROOT}/logs"
NFS_SHARE="${NFS_ROOT}/share"


# // NoMachine // # ------------------------------------------------------------

NM_NODE="${ADAROL_MAESTROER}"

NM_V_MAJOR="9"
NM_V_MINOR="7"

NM_V_PATCH="3"
NM_V_BUILD="1"


# // PostgreSQL // # -----------------------------------------------------------

PSQL_HOST="${ADAROL_DATABROKR}"
PSQL_PORT="5432"

PSQL_DB_NAME="adabase"
PSQL_TBL_NAME="staging"

PSQL_MQTT_DEST_FLD="payload"
PSQL_MQTT_TIMESTAMP_FLD="event_timestamp"

PSQL_CLUSTER_USER="${ADAUSR_SRV}"
PSQL_CLUSTER_PASSWORD="ClosedNetwork3K"

PSQL_COURIER_USER="coffee_courier"
PSQL_COURIER_PASSWORD="starsucks"


# // Telegraf // # -------------------------------------------------------------

TG_HOST="${ADAROL_DATABROKR}"
TG_INTERVAL="1s"
TG_FLUSH_INTERVAL="1s"
TG_OMIT_HOSTNAME="false"
TG_METRIC_BATCH_SIZE="500"
TG_METRIC_BUFFER_LIMIT="10000"


# // Style // # ----------------------------------------------------------------

ADA_BLU1="\e[38;5;39m"
ADA_BLU2="\e[38;5;27m"
ADA_PLUM="\e[38;5;53m"

ADA_WEIS="\e[38;5;255m"
ADA_GRAY="\e[38;5;240m"
ADA_RSET="\e[0m"

OOF_RED="\e[38;5;196m"
YAY_GRN="\e[38;5;46m"
