# ==============================================================================
# Ada Lovespace — Telesender Systemd Service
# Deploy via: sudo cp telesender.service /etc/systemd/system/
#             sudo systemctl daemon-reload
#             sudo systemctl enable --now telesender
#
# Environment vars loaded from /etc/default/telesender (created by build script).
# ==============================================================================

[Unit]
Description=Ada Lovespace — Telemetry Edge Node Scraper
Documentation=https://github.com/dvandagriff/adalovespace
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=adanaut
Group=adanaut
WorkingDirectory=${ADALOVESPACE_BIN}/ada/datapipes

EnvironmentFile=/etc/default/telesender

# Uses uv-managed venv (systemd can't run --script shebangs)
ExecStart=${ADALOVESPACE_BIN}/.venv/bin/python ${ADALOVESPACE_BIN}/ada/datapipes/telesender.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=6

# Logging via journal (default)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telesender

# Hardening: minimal filesystem access, no new privileges
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
