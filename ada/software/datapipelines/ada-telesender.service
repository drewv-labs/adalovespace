[Unit]
Description=Ada Postgres Telemetry Ingester
After=network.target postgresql.service mosquitto.service
Requires=postgresql.service mosquitto.service

[Service]
Type=simple
User=drew

# Absolute path to uv
ExecStart=/home/drew/.local/bin/uv run /opt/ada/scripts/telemetry_ingest.py

Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
