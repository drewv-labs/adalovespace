[Unit]
Description=Ada Node Telemetry Sender
After=network.target

[Service]
Type=simple
User=drew

# The magic happens here: use the absolute path to uv.
# If you are in the field WITHOUT internet, append: --no-index --find-links /path/to/wheelhouse
ExecStart=/home/drew/.local/bin/uv run /opt/ada/scripts/telemetry_sender.py

Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
